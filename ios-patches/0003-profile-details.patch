+<script lang="ts">
+	import { formatDistanceToNow } from "date-fns";
+	import ClockCounterClockwiseIcon from "phosphor-svelte/lib/ClockCounterClockwiseIcon";
+	import HashIcon from "phosphor-svelte/lib/HashIcon";
+	import ImagesIcon from "phosphor-svelte/lib/ImagesIcon";
+	import { toast } from "svelte-sonner";
+
+	import ProfileField from "./ProfileField.svelte";
+	import ProfileValueLabel from "./ProfileValueLabel.svelte";
+
+	let {
+		profileId,
+		lastUpdatedTime,
+		photoCount,
+	}: {
+		profileId: number;
+		lastUpdatedTime: number | null;
+		photoCount: number;
+	} = $props();
+
+	async function copyId() {
+		try {
+			const clipboard = await import("@tauri-apps/plugin-clipboard-manager");
+			await clipboard.writeText(String(profileId));
+			toast.success("Profile ID copied to clipboard");
+		} catch (error) {
+			console.error(error);
+		}
+	}
+</script>
+
+<ProfileField>
+	<HashIcon class="shrink-0" />
+	<ProfileValueLabel label="Profile ID">
+		<button type="button" class="underline-offset-4 hover:underline" onclick={copyId}>
+			{profileId}
+		</button>
+	</ProfileValueLabel>
+</ProfileField>
+{#if lastUpdatedTime !== null && lastUpdatedTime > 0}
+	<ProfileField>
+		<ClockCounterClockwiseIcon class="shrink-0" />
+		<ProfileValueLabel label="Profile updated">
+			{formatDistanceToNow(new Date(lastUpdatedTime), { addSuffix: true })}
+		</ProfileValueLabel>
+	</ProfileField>
+{/if}
+<ProfileField>
+	<ImagesIcon class="shrink-0" />
+	<ProfileValueLabel label="Public photos">
+		{photoCount}
+	</ProfileValueLabel>
+</ProfileField>
